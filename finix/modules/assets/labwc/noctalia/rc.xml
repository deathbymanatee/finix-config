<?xml version="1.0" encoding="UTF-8"?>
<labwc_config>
  <core>
    <gap>0</gap>
  </core>
  <!-- Thumbnail-based window switcher -->
  <windowSwitcher preview="no" outlines="yes">
    <osd style="thumbnail"/>
  </windowSwitcher>
  <keyboard>
    <default/>
    <!-- Reload config -->
    <keybind key="C-S-r">
      <action name="Reconfigure"/>
    </keybind>
    <!-- Noctalia core keys -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute">
        <command>noctalia msg panel-toggle launcher</command>
      </action>
    </keybind>
    <keybind key="W-space">
      <action name="Execute">
        <command>noctalia msg panel-toggle control-center</command>
      </action>
    </keybind>
    <keybind key="W-,">
      <action name="Execute">
        <command>noctalia msg settings-toggle</command>
      </action>
    </keybind>
    <keybind key="W-l">
      <action name="Execute">
        <command>noctalia msg session lock</command>
      </action>
    </keybind>
    <!-- Noctalia Media keys -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>noctalia msg volume-up</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>noctalia msg volume-down</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>noctalia msg volume-mute</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute">
        <command>noctalia msg brightness-up</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute">
        <command>noctalia msg brightness-down</command>
      </action>
    </keybind>
    <!-- screenshot keys -->
    <keybind key="Print">
      <action name="Execute">
        <command>sh -c "grim -g \"\$(slurp -o -r -c '#ff0000ff')\" -t ppm - | satty --filename - --fullscreen --output-filename ~/Pictures/Screenshots/satty-\$(date '+%Y%m%d-%H:%M:%S').png"</command>
      </action>
    </keybind>
    <keybind key="W-S-s">
      <action name="Execute">
        <command>sh -c 'grim -g "$(slurp)" -t ppm - | satty --filename - --output-filename ~/Pictures/Screenshots/satty-$(date '+%Y%m%d-%H:%M:%S').png'</command>
      </action>
    </keybind>
    <!-- workspace binds -->
    <keybind key="C-W-Left">
      <action name="GoToDesktop" to="left" wrap="yes"/>
    </keybind>
    <keybind key="C-W-Right">
      <action name="GoToDesktop" to="right" wrap="yes"/>
    </keybind>
    <!-- window binds -->
    <keybind key="W-c">
      <action name="Close"/>
    </keybind>
    <keybind key="W-f">
      <action name="ToggleMaximize"/>
    </keybind>
    <keybind key="W-m">
      <action name="Iconify"/>
    </keybind>
  </keyboard>
  <!-- workspaces -->
  <desktops>
    <popupTime>1000</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
    </names>
  </desktops>
  <theme>
    <name>GTK</name>
    <icon>Papirus-Dark</icon>
  </theme>
  <windowRules>
    <windowRule identifier="steam*">
      <action name="MoveToOutput" output="DP-3"/>
    </windowRule>
  </windowRules>
  <libinput>
    <device category="default">
      <tap>yes</tap>
      <scrollFactor>1.0</scrollFactor>
      <accelProfile>flat</accelProfile>
    </device>
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
      <tap>yes</tap>
      <scrollFactor>1.0</scrollFactor>
      <accelProfile>flat</accelProfile>
    </device>
  </libinput>
</labwc_config>
